{
  "name": "@yuniview/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "watch:run": "STATIC_DIR=../client/static bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/server",
    "check:lint": "biome check .",
    "check:test": "bun test src/",
    "check:type": "tsc --noEmit",
    "fix:lint": "biome check --write .",
    "watch:test": "bun test --watch src/",
    "watch:type": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@trpc/server": "^11.10.0",
    "hono": "^4.12.34",
    "jose": "^6",
    "pg": "^8.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.0"
  }
}
